{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESPHome: OTA (current file)",
       "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\esphome.exe",
      "args": [
        "run",
        "${file}",
        "--device",
        "OTA"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ESPHome: Logs (OTA)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\esphome.exe",
      "args": [
        "logs",
        "${file}",
        "--device",
        "OTA"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ESPHome: USB (current file)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\esphome.exe",
      "args": [
        "run",
        "${file}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ESPHome: Validate (current file)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\esphome.exe",
      "args": [
        "config",
        "${file}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
