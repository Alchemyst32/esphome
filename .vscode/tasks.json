{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESPHome: OTA (current file)",
       "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\esphome.exe",
      "args": [
        "run",
        "${file}",
        "--device",
        "OTA"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ESPHome: Logs (OTA)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\esphome.exe",
      "args": [
        "logs",
        "${file}",
        "--device",
        "OTA"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ESPHome: USB (current file)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\esphome.exe",
      "args": [
        "run",
        "${file}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ESPHome: Validate (current file)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\esphome.exe",
      "args": [
        "config",
        "${file}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "VS Entorno virtual Go",
      "type": "shell",
       "command": "powershell",
       "args": [
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". .\\.venv\\Scripts\\Activate.ps1"
        ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "VS Entorno virtual Out",
      "type": "shell",
       "command": "powershell",
  "args": [
    "-NoProfile",
    "-ExecutionPolicy",
    "Bypass",
    "-Command",
    "Write-Host '✅ Entorno virtual cerrado'; exit"
  ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
            "label": "ESPHome: Update Core + Build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-NoProfile",
                "-File",
                ".\\.vscode\\update_esphome.ps1"
            ],

            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
      },
     {
      "label": "Clean compilation (current file)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\esphome.exe",
      "args": [
        "clean",
        "${file}"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
        }
    },
  ]
}

